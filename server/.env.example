# Supabase → Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...

# RLS-ийг тойрдог тул ЗӨВХӨН сервер талд. Клиент рүү хэзээ ч оруулахгүй.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# AI Зөвлөгөө (арьс шинжилгээ) — https://aistudio.google.com дээр
# зээлийн карт шаардалгүй үнэгүй авна. ЗӨВХӨН сервер талд, клиент рүү хэзээ ч
# оруулахгүй ("EXPO_PUBLIC_"/"NEXT_PUBLIC_" угтваргүй байх ёстой).
GEMINI_API_KEY=

# .env файл болгож хуулаад өөрийн утгуудаа тавина уу:
#   cp .env.example .env
