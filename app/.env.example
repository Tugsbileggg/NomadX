# Supabase → Project Settings → API
# frontend-тэй ЯГ ИЖИЛ project руу заана.
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# .env файл болгож хуулаад өөрийн утгуудаа тавина уу:
#   cp .env.example .env

# CARTO суурь зургийн түлхүүр (заавал биш).
# Байхгүй бол OpenStreetMap руу автоматаар унана.
# Үнэгүй авах: https://carto.com/basemaps/apikey
EXPO_PUBLIC_CARTO_KEY=

# server/ (Hono API) — "AI Зөвлөгөө" tab үүгээр дамжуулж Gemini рүү зураг
# илгээнэ. Байхгүй бол зөвхөн энэ tab л ажиллахгүй, апп бусад талаараа хэвийн.
# Локал: http://localhost:3001 (`vc dev --listen 3001` — server/README.md).
EXPO_PUBLIC_SERVER_URL=
