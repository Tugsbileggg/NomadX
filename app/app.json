{
  "expo": {
    "name": "Lumina",
    "slug": "lumina",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/lumina-mark.png",
    "scheme": "lumina",
    "userInterfaceStyle": "automatic",
    "primaryColor": "#8a4853",
    "ios": {
      "bundleIdentifier": "mn.lumina.app",
      "buildNumber": "1",
      "supportsTablet": false,
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "comgooglemaps"
        ]
      }
    },
    "android": {
      "package": "mn.lumina.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/lumina-mark.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#fff8f7",
          "dark": {
            "backgroundColor": "#160f10"
          },
          "image": "./assets/images/lumina-mark.png",
          "imageWidth": 140
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "LUMINA нь ойролцоох мэргэжилтнүүдийг олоход, мөн захиалга идэвхтэй үед байршлыг харуулахад ашиглана."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Захиалга өгөхдөө ямар үйлчилгээ авахаа тайлбарлах жишээ зураг хавсаргахад ашиглана.",
          "cameraPermission": "Захиалгадаа жишээ зураг шууд авахад ашиглана."
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e5715a8f-f064-4777-9bcb-cfa9196c6aef"
      }
    },
    "owner": "tugsbileg"
  }
}
