# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# .env.local файл болгож хуулаад өөрийн утгуудаа тавина уу:
#   cp .env.local.example .env.local

# CARTO суурь зургийн түлхүүр (заавал биш).
# Байхгүй бол OpenStreetMap руу автоматаар унана.
# Үнэгүй авах: https://carto.com/basemaps/apikey
NEXT_PUBLIC_CARTO_KEY=

# Салон/артистын панелийн "Тусламж" хуудсанд харагдах холбоо барих мэдээлэл.
# Тохируулаагүй бол тухайн суваг огт харагдахгүй (зохиомол утга харуулахгүй).
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SUPPORT_PHONE=
